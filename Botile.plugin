"""Botile: rounded-square avatars for Telegram bots.

Hooks the shared ImageReceiver paths used by exteraless 12.10.6+:

* setForUserOrChat() identifies the TLRPC entity and marks bot receivers.
* setRoundRadius() enforces Botile's radius while preserving the app baseline.
* setImage()/setImageBitmap() clear bot state for custom images.
* draw() adds a thin theme-adaptive outline after the bot avatar is painted.

Regular users, groups, channels and custom images keep the client's radius.
"""

import threading

from base_plugin import BasePlugin, HookFilter, MethodHook
from hook_utils import find_class

__id__ = "botile"
__name__ = "Botile"
__description__ = "Give bots a distinct avatar shape."
__author__ = "Botile contributors"
__version__ = "1.2.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.3"
__permissions__ = ["hooks"]

BOT_CORNER_RADIUS_DP = 11
BOT_BORDER_WIDTH_DP = 1.0
BOT_BORDER_ALPHA = 0.45
BOT_BORDER_MIN_DP = 0.5
BOT_BORDER_MAX_DP = 3.0
FRAME_COLOR_THEME = 0
FRAME_COLOR_ACCENT = 1
FRAME_COLOR_WHITE = 2
FRAME_COLOR_BLACK = 3
FRAME_COLOR_ITEMS = (
    "Theme / Тема",
    "Accent / Акцент",
    "White / Белая",
    "Black / Чёрная",
)
MARKER = "botile:bot"

# Direct ImageReceiver.setImage() avatar parents. These do not use
# setForUserOrChat but pass the TLRPC entity as parentObject.
DIRECT_AVATAR_PARENTS = (
    "org.telegram.ui.ProfileActivity$AvatarImageView",
    "org.telegram.ui.ProfileActivity2$AvatarImage",
    "org.telegram.ui.Cells.ProfileSearchCell",
)


def _is_direct_avatar_parent(name):
    if not name:
        return False
    for parent in DIRECT_AVATAR_PARENTS:
        if name == parent or name.startswith(parent + "$"):
            return True
    return False


def _as_java_class(clazz):
    """Normalize find_class()'s Chaquopy proxy to java.lang.Class."""
    if clazz is None:
        return None
    try:
        from hook_utils import _as_class

        normalized = _as_class(clazz)
        if normalized is not None:
            return normalized
    except Exception:
        pass
    try:
        from java.lang import Class

        if isinstance(clazz, Class):
            return clazz
    except Exception:
        pass
    try:
        return clazz.getClass()
    except Exception:
        return clazz


def _find_declared_method(clazz, name, parameter_names):
    """Find one exact overload after normalizing the class proxy."""
    try:
        target = _as_java_class(clazz)
        if target is None:
            return None
        expected = tuple(parameter_names)
        methods = target.getDeclaredMethods()
        for index in range(len(methods)):
            method = methods[index]
            if str(method.getName()) != name:
                continue
            parameters = method.getParameterTypes()
            if len(parameters) != len(expected):
                continue
            actual = tuple(
                str(parameters[i].getName()) for i in range(len(parameters))
            )
            if actual == expected:
                method.setAccessible(True)
                return method
    except Exception:
        pass
    return None


MARK_CONDITION = (
    'thisObject.getMark() != null && '
    'thisObject.getMark().equals("%s")' % MARKER
)
# Background-thread draws pass a holder and must not be touched from Python.
BORDER_CONDITION = MARK_CONDITION + ' && args[1] == null'


def _is_bot(entity):
    try:
        return bool(entity.bot)
    except Exception:
        return False


class _BindHook(MethodHook):
    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        self._plugin._local.avatar_depth = 1

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            plugin._local.avatar_depth = 0
            args = param.args
            entity = args[0] if args else None
            plugin._on_bind(param.thisObject, entity)
        except Exception as error:
            plugin._report_error("bind", error)


class _RadiusHook(MethodHook):
    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "applying", 0) > 0:
                return
            args = param.args
            if args is None or not args:
                return
            plugin._override_radius(param.thisObject, args[0])
        except Exception as error:
            plugin._report_error("radius", error)


class _ImageHook(MethodHook):
    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "avatar_depth", 0) > 0:
                return
            args = param.args
            parent = args[9] if args is not None and len(args) > 9 else None
            plugin._on_image(param.thisObject, parent)
        except Exception as error:
            plugin._report_error("image", error)


class _BitmapHook(MethodHook):
    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "avatar_depth", 0) > 0:
                return
            plugin._on_custom_image(param.thisObject)
        except Exception as error:
            plugin._report_error("bitmap", error)


class _BorderDrawHook(MethodHook):
    def __init__(self, plugin):
        self._plugin = plugin

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            args = param.args
            if not param.getResult() or args is None or len(args) < 2:
                return
            if args[1] is not None:
                return
            plugin._draw_border(args[0], param.thisObject)
        except Exception as error:
            plugin._report_error("border", error)


class _DialogFallbackHook(MethodHook):
    def __init__(self, plugin):
        self._plugin = plugin

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            cell = param.thisObject
            receiver = cell.avatarImage if cell is not None else None
            if receiver is None or not plugin._is_marked(receiver):
                return
            plugin._force_radius(receiver)
            try:
                cell.invalidate()
            except Exception:
                pass
        except Exception as error:
            plugin._report_error("dialog", error)


class BotilePlugin(BasePlugin):
    _unhooks = None
    _baselines = None
    _applied = None
    _marks = None
    _mark_nulls = None
    _arrays = None
    _border_paint = None
    _border_rect = None
    _border_stroke = 1.0
    _theme = None
    _local = None
    _lock = None

    def create_settings(self):
        from ui.settings import Header, Selector, Slider, Switch

        return [
            Header("Bot avatar frame / Рамка аватара"),
            Switch(
                key="frame_enabled",
                text="Show frame / Показывать рамку",
                default=True,
                subtext="Bot avatars only / Только для ботов",
            ),
            Selector(
                key="frame_color",
                text="Frame color / Цвет рамки",
                default=FRAME_COLOR_THEME,
                items=list(FRAME_COLOR_ITEMS),
                subtext="Theme follows light/dark / Тема следует оформлению",
            ),
            Slider(
                key="frame_thickness",
                text="Frame thickness / Толщина рамки",
                default=BOT_BORDER_WIDTH_DP,
                min=BOT_BORDER_MIN_DP,
                max=BOT_BORDER_MAX_DP,
                step=0.5,
                subtext="0.5–3.0 dp / 0.5–3.0 dp",
            ),
        ]

    def on_plugin_load(self):
        self._unhooks = []
        self._hooks_ok = {}
        self._local = threading.local()
        self._lock = threading.RLock()
        self._errors = set()
        self._first_bind_logged = False
        self._unknown_parent_logged = False
        self._remove_hooks()

        self.log(
            "Botile %s starting (installed metadata version=%s)"
            % (__version__, getattr(self, "version", "?"))
        )

        if not self._has_hooks_permission():
            return

        try:
            from java.util import Arrays, WeakHashMap
            from org.telegram.messenger import AndroidUtilities

            self._radius_px = int(AndroidUtilities.dp(BOT_CORNER_RADIUS_DP))
            self._arrays = Arrays
            self._baselines = WeakHashMap()
            self._applied = WeakHashMap()
            self._marks = WeakHashMap()
            self._mark_nulls = WeakHashMap()
        except Exception as error:
            self.log("Botile cannot initialise state: %s: %s"
                     % (type(error).__name__, error))
            return

        self._border_paint = None
        self._border_rect = None
        self._theme = None
        try:
            from android.graphics import Paint, RectF
            from org.telegram.ui.ActionBar import Theme

            self._theme = Theme
            self._border_stroke = max(
                1.0, float(AndroidUtilities.dpf2(BOT_BORDER_WIDTH_DP))
            )
            self._border_paint = Paint()
            self._border_paint.setAntiAlias(True)
            self._border_paint.setStyle(Paint.Style.STROKE)
            self._border_paint.setStrokeWidth(self._border_stroke)
            self._border_rect = RectF()
        except Exception as error:
            self.log("diag border disabled: %s: %s"
                     % (type(error).__name__, error))

        try:
            image_receiver = _as_java_class(
                find_class("org.telegram.messenger.ImageReceiver")
            )
            dialog_cell = _as_java_class(
                find_class("org.telegram.ui.Cells.DialogCell")
            )
            if image_receiver is None:
                self.log("Botile inactive: ImageReceiver class not found")
                return

            mark_filter = HookFilter.Condition(MARK_CONDITION)
            image_filter = HookFilter.Or(
                HookFilter.ArgumentIsInstanceOf(9, "org.telegram.tgnet.TLRPC$User"),
                HookFilter.ArgumentIsInstanceOf(9, "org.telegram.tgnet.TLRPC$Chat"),
                mark_filter,
            )

            if not self._install_bind_hook(image_receiver):
                self.log("Botile inactive: bind hook not installed")
                return
            self._install_radius_hook(image_receiver, mark_filter)
            self._install_image_hook(image_receiver, image_filter)
            self._install_border_hook(image_receiver)
            self._install_bitmap_hooks(image_receiver, mark_filter)
            if dialog_cell is not None:
                self._install_dialog_hook(dialog_cell)

            self._log_hook_summary()
        except Exception as error:
            self.log("Botile startup failed: %s: %s"
                     % (type(error).__name__, error))

    def on_plugin_unload(self):
        self.log("Botile %s unloading" % __version__)
        self._remove_hooks()
        self._restore_all()

    # ---- hook installation ------------------------------------------------

    def _install_bind_hook(self, image_receiver):
        method = _find_declared_method(
            image_receiver,
            "setForUserOrChat",
            (
                "org.telegram.tgnet.TLObject",
                "android.graphics.drawable.Drawable",
                "java.lang.Object",
                "boolean",
                "int",
                "boolean",
            ),
        )
        if method is None:
            self.log("hook bind: FAILED exact signature not found")
            return False
        if self._hook("bind", method, _BindHook(self)) is None:
            return False
        self.log("hook bind: installed setForUserOrChat")
        return True

    def _install_radius_hook(self, image_receiver, mark_filter):
        method = self._find_radius_method(image_receiver)
        if method is None:
            self.log("hook radius: FAILED setRoundRadius(int[]) not found")
            return
        if self._hook(
            "radius", method, _RadiusHook(self),
            before_filters=[mark_filter],
        ) is not None:
            self.log("hook radius: installed setRoundRadius(int[])")

    def _install_image_hook(self, image_receiver, image_filter):
        method = _find_declared_method(
            image_receiver,
            "setImage",
            (
                "org.telegram.messenger.ImageLocation",
                "java.lang.String",
                "org.telegram.messenger.ImageLocation",
                "java.lang.String",
                "org.telegram.messenger.ImageLocation",
                "java.lang.String",
                "android.graphics.drawable.Drawable",
                "long",
                "java.lang.String",
                "java.lang.Object",
                "int",
            ),
        )
        if method is None:
            self.log("hook image: FAILED exact signature not found")
            return
        if self._hook(
            "image", method, _ImageHook(self),
            before_filters=[image_filter],
        ) is not None:
            self.log("hook image: installed setImage core")

    def _install_border_hook(self, image_receiver):
        if self._border_paint is None:
            self.log("hook border: skipped (Paint/RectF unavailable)")
            return
        method = _find_declared_method(
            image_receiver,
            "draw",
            (
                "android.graphics.Canvas",
                "org.telegram.messenger.ImageReceiver$BackgroundThreadDrawHolder",
            ),
        )
        if method is None:
            self.log("hook border: FAILED exact signature not found")
            return
        if self._hook(
            "border", method, _BorderDrawHook(self),
            after_filters=[HookFilter.Condition(BORDER_CONDITION)],
        ) is not None:
            self.log("hook border: installed draw outline")

    def _install_bitmap_hooks(self, image_receiver, mark_filter):
        found = 0
        try:
            methods = image_receiver.getDeclaredMethods()
            for index in range(len(methods)):
                method = methods[index]
                if str(method.getName()) != "setImageBitmap":
                    continue
                method.setAccessible(True)
                if self._hook(
                    "bitmap", method, _BitmapHook(self),
                    before_filters=[mark_filter],
                ) is not None:
                    found += 1
        except Exception as error:
            self.log("hook bitmap: FAILED %s: %s"
                     % (type(error).__name__, error))
        if found:
            self.log("hook bitmap: installed %d setImageBitmap overload(s)" % found)

    def _install_dialog_hook(self, dialog_cell):
        method = _find_declared_method(dialog_cell, "update", ("int", "boolean"))
        if method is None:
            self.log("hook dialog: FAILED exact signature not found")
            return
        if self._hook("dialog", method, _DialogFallbackHook(self)) is not None:
            self.log("hook dialog: installed update fallback")

    def _find_radius_method(self, image_receiver):
        try:
            methods = image_receiver.getDeclaredMethods()
            for index in range(len(methods)):
                method = methods[index]
                if str(method.getName()) != "setRoundRadius":
                    continue
                params = method.getParameterTypes()
                if len(params) != 1 or not params[0].isArray():
                    continue
                if str(params[0].getComponentType().getName()) == "int":
                    method.setAccessible(True)
                    return method
        except Exception:
            pass
        return None

    def _hook(self, label, method, handler, before_filters=None, after_filters=None):
        try:
            unhook = self.hook_method(
                method,
                handler,
                priority=50,
                before_filters=before_filters,
                after_filters=after_filters,
            )
            if unhook is None:
                self.log("hook %s: FAILED (registrar returned nothing)" % label)
                return None
            self._add_unhook(unhook)
            self._hooks_ok[label] = True
            return unhook
        except Exception as error:
            self.log("hook %s: FAILED %s: %s"
                     % (label, type(error).__name__, error))
            return None

    def _add_unhook(self, unhook):
        if isinstance(unhook, (list, tuple)):
            self._unhooks.extend(unhook)
        else:
            self._unhooks.append(unhook)

    def _remove_hooks(self):
        for unhook in list(self._unhooks or []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks = []

    def _flag(self, name):
        return "OK" if getattr(self, "_hooks_ok", {}).get(name) else "FAILED"

    def _log_hook_summary(self):
        self.log(
            f"Botile hooks: bind=OK radius={self._flag('radius')} "
            f"image={self._flag('image')} border={self._flag('border')} "
            f"dialog={self._flag('dialog')}"
        )

    # ---- avatar state -----------------------------------------------------

    def _on_bind(self, receiver, entity):
        with self._lock:
            if receiver is None:
                return
            if not self._first_bind_logged:
                self._first_bind_logged = True
                self.log(
                    "diag first bind: id=%s bot=%s parent=%s"
                    % (self._entity_id(entity), _is_bot(entity),
                       self._parent_name(receiver))
                )
            if _is_bot(entity):
                self._apply_bot(receiver)
            else:
                self._clear_bot(receiver)

    def _on_image(self, receiver, parent_object):
        with self._lock:
            if _is_bot(parent_object):
                parent = self._parent_name(receiver)
                if _is_direct_avatar_parent(parent):
                    self._apply_bot(receiver)
                elif not self._unknown_parent_logged:
                    self._unknown_parent_logged = True
                    self.log("diag direct avatar parent not covered: %s" % parent)
                return
            self._clear_bot(receiver)

    def _on_custom_image(self, receiver):
        with self._lock:
            if receiver is None:
                return
            if not self._is_marked(receiver) and self._baseline_array(receiver) is None:
                return
            self._clear_bot(receiver)

    def _apply_bot(self, receiver):
        with self._lock:
            if receiver is None:
                return
            current = self._corners_of(receiver)
            baseline_array = self._baseline_array(receiver)
            if baseline_array is None:
                baseline_array = self._copy_corners(receiver.getRoundRadius())
                if baseline_array is not None:
                    self._baselines.put(receiver, baseline_array)
            baseline = self._array_values(baseline_array)
            size_hint = self._max_corner(baseline)
            if size_hint <= 0:
                size_hint = self._max_corner(current)
            applied = self._bot_radius(receiver, size_hint)
            self._applied.put(receiver, int(applied))
            self._save_mark(receiver)
            self._set_mark(receiver, MARKER)
            self._apply_radius(receiver, applied)

    def _override_radius(self, receiver, values):
        with self._lock:
            if receiver is None or values is None:
                return
            baseline_array = self._baseline_array(receiver)
            if baseline_array is None and not self._is_marked(receiver):
                return
            requested_array = self._copy_corners(values)
            if requested_array is not None:
                self._baselines.put(receiver, requested_array)
            requested = self._array_values(requested_array)
            applied = self._bot_radius(receiver, self._max_corner(requested))
            self._applied.put(receiver, int(applied))
            try:
                receiver.setAvatarCornersApplied(True)
            except Exception:
                pass
            for index in range(min(4, len(values))):
                values[index] = applied

    def _force_radius(self, receiver):
        with self._lock:
            if receiver is None:
                return
            self._apply_radius(receiver, self._applied_radius(receiver), False)

    def _apply_radius(self, receiver, value, invalidate=True):
        self._enter_apply()
        try:
            try:
                receiver.setAvatarCornersApplied(True)
            except Exception:
                pass
            receiver.setRoundRadius(value)
            if invalidate:
                try:
                    receiver.invalidate()
                except Exception:
                    pass
        finally:
            self._exit_apply()

    def _clear_bot(self, receiver):
        with self._lock:
            if receiver is None:
                return
            marked = self._is_marked(receiver)
            baseline_array = self._baseline_array(receiver)
            if not marked and baseline_array is None:
                return
            current = self._corners_of(receiver)
            applied = self._applied_radius(receiver)
            restore = baseline_array is not None
            if current is not None and not self._corners_are(current, applied):
                # The app already applied a new radius; it is authoritative.
                restore = False
            if restore:
                self._apply_radius(receiver, baseline_array)
            self._restore_mark(receiver)
            for mapping in (self._baselines, self._applied):
                try:
                    mapping.remove(receiver)
                except Exception:
                    pass

    def _restore_all(self):
        baselines = self._baselines
        applied = self._applied
        marks = self._marks
        mark_nulls = self._mark_nulls
        self._baselines = None
        if baselines is None and marks is None and mark_nulls is None:
            return

        def restore():
            with self._lock:
                keys = []
                for mapping in (baselines, marks, mark_nulls):
                    if mapping is not None:
                        try:
                            keys.extend(list(mapping.keySet()))
                        except Exception:
                            pass
                for receiver in keys:
                    try:
                        baseline = (
                            baselines.get(receiver) if baselines is not None else None
                        )
                        if baseline is not None:
                            self._apply_radius(receiver, baseline)
                        self._restore_mark(receiver, marks, mark_nulls)
                    except Exception:
                        pass
                for mapping in (baselines, marks, mark_nulls, applied):
                    if mapping is not None:
                        try:
                            mapping.clear()
                        except Exception:
                            pass

        try:
            from android_utils import run_on_ui_thread

            run_on_ui_thread(restore)
        except Exception:
            pass

    # ---- border -----------------------------------------------------------

    def _frame_config(self):
        try:
            enabled = self.get_setting("frame_enabled", True)
        except Exception:
            enabled = True
        enabled = True if enabled is None else bool(enabled)

        try:
            color = int(self.get_setting("frame_color", FRAME_COLOR_THEME))
        except Exception:
            color = FRAME_COLOR_THEME
        color = max(0, min(len(FRAME_COLOR_ITEMS) - 1, color))

        try:
            thickness = float(
                self.get_setting("frame_thickness", BOT_BORDER_WIDTH_DP)
            )
        except Exception:
            thickness = BOT_BORDER_WIDTH_DP
        thickness = max(BOT_BORDER_MIN_DP, min(BOT_BORDER_MAX_DP, thickness))
        return enabled, color, thickness

    def _frame_color(self, index):
        if index == FRAME_COLOR_ACCENT:
            return self._theme.getColor(self._theme.key_chat_messagePanelSend)
        if index == FRAME_COLOR_WHITE:
            return 0xFFFFFFFF
        if index == FRAME_COLOR_BLACK:
            return 0xFF000000
        return self._theme.getColor(self._theme.key_windowBackgroundWhiteBlackText)

    def _draw_border(self, canvas, receiver):
        if (
            canvas is None
            or receiver is None
            or self._border_paint is None
            or self._border_rect is None
            or self._theme is None
            or not self._is_marked(receiver)
        ):
            return
        enabled, color_index, thickness = self._frame_config()
        if not enabled:
            return
        try:
            width = float(receiver.getImageWidth())
            height = float(receiver.getImageHeight())
        except Exception:
            return
        if width <= 0 or height <= 0:
            return
        try:
            alpha = float(receiver.getAlpha()) * float(receiver.getCurrentAlpha())
        except Exception:
            alpha = 1.0
        alpha = max(0.0, min(1.0, alpha))
        if alpha <= 0.01:
            return
        stroke = max(1.0, self._border_stroke * thickness)
        if width <= stroke or height <= stroke:
            return
        inset = stroke * 0.5
        rect = self._border_rect
        x = float(receiver.getImageX())
        y = float(receiver.getImageY())
        rect.set(x + inset, y + inset, x + width - inset, y + height - inset)
        radius = 0.0
        try:
            radii = receiver.getRoundRadius()
            if radii is not None and len(radii) > 0:
                radius = float(radii[0])
        except Exception:
            pass
        radius = max(0.0, min(radius, min(rect.width(), rect.height()) * 0.5))
        color = self._frame_color(color_index)
        self._border_paint.setColor(
            self._theme.multAlpha(color, BOT_BORDER_ALPHA * alpha)
        )
        self._border_paint.setStrokeWidth(stroke)
        canvas.drawRoundRect(rect, radius, radius, self._border_paint)

    # ---- helpers ----------------------------------------------------------

    def _has_hooks_permission(self):
        try:
            from app.exteraless.plugins import PythonBridge

            allowed = bool(PythonBridge.hasPermission(self.id, "hooks"))
            self.log("diag hooks permission=%s" % allowed)
            if not allowed:
                self.log("Botile inactive: grant the hooks permission")
            return allowed
        except Exception as error:
            self.log("diag hooks permission query failed: %s" % error)
            return True

    def _report_error(self, where, error):
        key = (where, type(error).__name__, str(error)[:100])
        if key in self._errors or len(self._errors) >= 6:
            return
        self._errors.add(key)
        self.log("diag hook error [%s]: %s: %s"
                 % (where, type(error).__name__, error))

    def _enter_apply(self):
        self._local.applying = getattr(self._local, "applying", 0) + 1

    def _exit_apply(self):
        local = self._local
        local.applying = max(0, getattr(local, "applying", 1) - 1)

    def _bot_radius(self, receiver, size_hint=None):
        try:
            width = receiver.getImageWidth()
        except Exception:
            width = 0
        size_px = int(width) if width and width > 0 else 0
        if size_px <= 0 and size_hint is not None and size_hint > 0:
            size_px = int(size_hint) * 2
        if size_px <= 0:
            return self._radius_px
        return max(1, min(self._radius_px, int(round(size_px * 0.22))))

    def _applied_radius(self, receiver):
        try:
            value = self._applied.get(receiver)
            if value is not None:
                return int(value)
        except Exception:
            pass
        return self._bot_radius(receiver)

    def _baseline_array(self, receiver):
        try:
            return self._baselines.get(receiver)
        except Exception:
            return None

    def _copy_corners(self, values):
        if values is None:
            return None
        try:
            return self._arrays.copyOf(values, 4)
        except Exception:
            try:
                return [int(values[i]) if i < len(values) else 0 for i in range(4)]
            except Exception:
                return None

    def _array_values(self, values):
        if values is None:
            return None
        try:
            return tuple(int(values[i]) if i < len(values) else 0 for i in range(4))
        except Exception:
            return None

    def _corners_of(self, receiver):
        try:
            return self._array_values(receiver.getRoundRadius())
        except Exception:
            return None

    def _max_corner(self, values):
        return max(0, max(values)) if values else 0

    def _corners_are(self, values, applied):
        return values is not None and all(int(value) == applied for value in values)

    def _is_marked(self, receiver):
        try:
            mark = receiver.getMark()
            return mark is not None and str(mark) == MARKER
        except Exception:
            return False

    def _set_mark(self, receiver, value):
        try:
            receiver.setMark(value)
        except Exception:
            pass

    def _save_mark(self, receiver):
        try:
            current = receiver.getMark()
            if current is not None and str(current) == MARKER:
                return
            for mapping in (self._marks, self._mark_nulls):
                try:
                    mapping.remove(receiver)
                except Exception:
                    pass
            if current is None:
                self._mark_nulls.put(receiver, True)
            else:
                self._marks.put(receiver, current)
        except Exception as error:
            self._report_error("mark-save", error)

    def _restore_mark(self, receiver, marks=None, mark_nulls=None):
        if marks is None:
            marks = self._marks
        if mark_nulls is None:
            mark_nulls = self._mark_nulls
        try:
            current = receiver.getMark()
            current_is_botile = current is not None and str(current) == MARKER
            saved = False
            original = None
            try:
                if marks is not None and marks.containsKey(receiver):
                    original = marks.get(receiver)
                    saved = True
                elif mark_nulls is not None and mark_nulls.containsKey(receiver):
                    saved = True
            except Exception:
                pass
            if current_is_botile:
                self._set_mark(receiver, original if saved else None)
        finally:
            for mapping in (marks, mark_nulls):
                try:
                    mapping.remove(receiver)
                except Exception:
                    pass

    def _parent_name(self, receiver):
        try:
            parent = receiver.getParentView()
            return "none" if parent is None else str(parent.getClass().getName())
        except Exception:
            return "?"

    def _entity_id(self, entity):
        try:
            return str(entity.id)
        except Exception:
            return "?"
