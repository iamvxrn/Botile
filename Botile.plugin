"""Botile: give bots a distinct avatar shape.

Botile v1 used one DialogCell hook and silently depended on private-field
reflection. This version hooks the shared avatar path instead:

* ImageReceiver.setForUserOrChat() supplies the actual TLRPC entity.
* ImageReceiver.setRoundRadius(int[]) is the common radius path, so callers
  that apply a radius after setting the image cannot overwrite Botile.
* ImageReceiver.setImage()/setImageBitmap() clear bot state when a custom
  (non-entity) image replaces an avatar.

A bot receiver is marked with a string in ImageReceiver.mark, and its original
radius is kept in a WeakHashMap. Regular users, groups and channels keep the
radius the app chose.
"""

import threading

from base_plugin import BasePlugin, HookFilter, MethodHook
from hook_utils import find_class

__id__ = "botile"
__name__ = "Botile"
__description__ = "Give bots a distinct avatar shape."
__author__ = "Botile contributors"
__version__ = "1.1.0"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.3"
__permissions__ = ["hooks"]

BOT_CORNER_RADIUS_DP = 11
MARKER = "botile:bot"
SUMMARY_EVERY = 500

# Direct ImageReceiver avatars that do not go through setForUserOrChat.
# ProfileActivity/ProfileActivity2 and ProfileSearchCell pass the TLRPC entity
# as setImage(parentObject, ...) instead.
DIRECT_AVATAR_PARENTS = (
    "org.telegram.ui.ProfileActivity$AvatarImageView",
    "org.telegram.ui.ProfileActivity2$AvatarImage",
    "org.telegram.ui.Cells.ProfileSearchCell",
)


def _is_direct_avatar_parent(name):
    if not name:
        return False
    for parent in DIRECT_AVATAR_PARENTS:
        if name == parent or name.startswith(parent + "$"):
            return True
    return False

MARK_CONDITION = (
    'thisObject.getMark() != null && '
    'thisObject.getMark().equals("%s")' % MARKER
)


def _entity_is_bot(entity):
    if entity is None:
        return False
    try:
        return bool(entity.bot)
    except Exception:
        return False


class _BindHook(MethodHook):
    """Track an avatar entity while its receiver is being populated."""

    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        # setForUserOrChat is not reentrant. A simple 1/0 flag also recovers
        # cleanly if a previous call threw before its after-hook ran.
        self._plugin._local.avatar_depth = 1

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            plugin._local.avatar_depth = 0
            receiver = param.thisObject
            entity = param.args[0] if param.args else None
            plugin._on_avatar_bind(receiver, entity)
        except Exception as error:
            plugin._report_hook_error("bind", error)


class _RadiusHook(MethodHook):
    """Force the bot radius whenever the app sets a radius on a marked receiver."""

    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "applying", 0) > 0:
                return
            receiver = param.thisObject
            values = param.args[0] if param.args else None
            if receiver is None or values is None:
                return
            plugin._override_radius(receiver, values)
        except Exception as error:
            plugin._report_hook_error("radius", error)

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "applying", 0) > 0:
                return
            plugin._verify_radius(param.thisObject)
        except Exception as error:
            plugin._report_hook_error("radius-after", error)


class _ImageHook(MethodHook):
    """Handle direct entity avatars and clear bot state for custom images."""

    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "avatar_depth", 0) > 0:
                return
            receiver = param.thisObject
            if receiver is None:
                return
            args = param.args
            parent_object = args[9] if args is not None and len(args) > 9 else None
            plugin._on_image_set(receiver, parent_object)
        except Exception as error:
            plugin._report_hook_error("image", error)


class _BitmapHook(MethodHook):
    """Clear bot state when a bitmap replaces a marked avatar."""

    def __init__(self, plugin):
        self._plugin = plugin

    def before_hooked_method(self, param):
        plugin = self._plugin
        try:
            if getattr(plugin._local, "avatar_depth", 0) > 0:
                return
            plugin._on_custom_image(param.thisObject)
        except Exception as error:
            plugin._report_hook_error("bitmap", error)


class _DialogFallbackHook(MethodHook):
    """Re-apply the radius after DialogCell finishes its own radius update."""

    def __init__(self, plugin):
        self._plugin = plugin

    def after_hooked_method(self, param):
        plugin = self._plugin
        try:
            cell = param.thisObject
            if cell is None:
                return
            receiver = cell.avatarImage
            if receiver is None or not plugin._is_marked(receiver):
                return
            plugin._force_and_verify(receiver, "dialog")
            try:
                cell.invalidate()
            except Exception:
                pass
        except Exception as error:
            plugin._report_hook_error("dialog", error)


class BotilePlugin(BasePlugin):
    _unhooks = None
    _baselines = None
    _applied = None
    _marks = None
    _mark_nulls = None
    _arrays = None
    _local = None
    _lock = None

    # ---- lifecycle ---------------------------------------------------------

    def on_plugin_load(self):
        self._unhooks = []
        self._hooks_ok = {}
        self._baselines = None
        self._local = threading.local()
        self._lock = threading.RLock()
        self._errors = set()
        self._firsts = set()
        self._stats = {
            "binds": 0,
            "bots": 0,
            "nonbots": 0,
            "overrides": 0,
            "verified": 0,
            "clears": 0,
            "custom": 0,
            "dialog": 0,
            "unknown_parent": 0,
        }
        self._remove_hooks()

        self.log(
            "Botile %s starting (installed metadata version=%s)"
            % (__version__, getattr(self, "version", "?"))
        )

        if not self._has_hooks_permission():
            return

        try:
            from java.util import Arrays, WeakHashMap
            from org.telegram.messenger import AndroidUtilities

            self._radius_px = int(AndroidUtilities.dp(BOT_CORNER_RADIUS_DP))
            self._arrays = Arrays
            self._baselines = WeakHashMap()
            self._applied = WeakHashMap()
            self._marks = WeakHashMap()
            self._mark_nulls = WeakHashMap()
        except Exception as error:
            self.log(
                "Botile cannot initialise radius/runtime state: %s: %s"
                % (type(error).__name__, error)
            )
            return

        try:
            image_receiver = find_class("org.telegram.messenger.ImageReceiver")
            dialog_cell = find_class("org.telegram.ui.Cells.DialogCell")
            if image_receiver is None:
                self.log("Botile inactive: ImageReceiver class not found")
                return

            mark_filter = HookFilter.Condition(MARK_CONDITION)
            image_filter = HookFilter.Or(
                HookFilter.ArgumentIsInstanceOf(9, "org.telegram.tgnet.TLRPC$User"),
                HookFilter.ArgumentIsInstanceOf(9, "org.telegram.tgnet.TLRPC$Chat"),
                mark_filter,
            )

            bind_ok = self._install_bind_hook(image_receiver)
            if not bind_ok:
                self.log("Botile inactive: central avatar bind hook was not installed")
                return

            self._install_radius_hook(image_receiver, mark_filter)
            self._install_image_hook(image_receiver, image_filter)
            self._install_bitmap_hooks(image_receiver, mark_filter)
            if dialog_cell is not None:
                self._install_dialog_hook(dialog_cell)
            else:
                self.log("Botile note: DialogCell not found; central hooks remain active")

            self.log(
                "Botile hooks: bind=OK radius=%s image=%s dialog=%s"
                % (self._flag("radius"), self._flag("image"), self._flag("dialog"))
            )
            self._log_runtime_state(after_hooks=True)
        except Exception as error:
            self.log(
                "Botile startup failed: %s: %s"
                % (type(error).__name__, error)
            )

    def on_plugin_unload(self):
        self.log(
            "Botile %s unloading: binds=%d bots=%d nonbots=%d overrides=%d "
            "verified=%d clears=%d custom=%d dialog=%d unknown_parent=%d"
            % (
                __version__,
                self._stats.get("binds", 0),
                self._stats.get("bots", 0),
                self._stats.get("nonbots", 0),
                self._stats.get("overrides", 0),
                self._stats.get("verified", 0),
                self._stats.get("clears", 0),
                self._stats.get("custom", 0),
                self._stats.get("dialog", 0),
                self._stats.get("unknown_parent", 0),
            )
        )
        self._remove_hooks()
        self._restore_all()

    # ---- hook installation -------------------------------------------------

    def _install_bind_hook(self, image_receiver):
        try:
            from android.graphics.drawable import Drawable
            from java.lang import Boolean, Integer, Object
            from org.telegram.tgnet import TLObject

            method = image_receiver.getDeclaredMethod(
                "setForUserOrChat",
                TLObject,
                Drawable,
                Object,
                Boolean.TYPE,
                Integer.TYPE,
                Boolean.TYPE,
            )
            method.setAccessible(True)
            unhook = self.hook_method(method, _BindHook(self), priority=50)
            if unhook is None:
                self.log("hook bind: FAILED (registrar returned nothing)")
                return False
            self._add_unhook(unhook)
            self._hooks_ok["bind"] = True
            self.log("hook bind: installed ImageReceiver.setForUserOrChat")
            return True
        except Exception as error:
            self.log(
                "hook bind: FAILED %s: %s"
                % (type(error).__name__, error)
            )
            return False

    def _install_radius_hook(self, image_receiver, mark_filter):
        method = self._find_radius_method(image_receiver)
        if method is None:
            self.log("hook radius: FAILED ImageReceiver.setRoundRadius(int[]) not found")
            return
        unhook = self._hook(label="radius", method=method,
                            handler=_RadiusHook(self), before_filters=[mark_filter],
                            after_filters=[mark_filter])
        if unhook is not None:
            self.log("hook radius: installed ImageReceiver.setRoundRadius(int[])")

    def _install_image_hook(self, image_receiver, image_filter):
        try:
            from android.graphics.drawable import Drawable
            from java.lang import Integer, Long, Object, String
            from org.telegram.messenger import ImageLocation

            method = image_receiver.getDeclaredMethod(
                "setImage",
                ImageLocation,
                String,
                ImageLocation,
                String,
                ImageLocation,
                String,
                Drawable,
                Long.TYPE,
                String,
                Object,
                Integer.TYPE,
            )
            method.setAccessible(True)
            unhook = self._hook(
                label="image",
                method=method,
                handler=_ImageHook(self),
                before_filters=[image_filter],
            )
            if unhook is not None:
                self.log("hook image: installed ImageReceiver.setImage core")
        except Exception as error:
            self.log(
                "hook image: FAILED %s: %s"
                % (type(error).__name__, error)
            )

    def _install_bitmap_hooks(self, image_receiver, mark_filter):
        try:
            methods = image_receiver.getDeclaredMethods()
            found = 0
            for index in range(len(methods)):
                method = methods[index]
                if str(method.getName()) != "setImageBitmap":
                    continue
                method.setAccessible(True)
                unhook = self._hook(
                    label="bitmap",
                    method=method,
                    handler=_BitmapHook(self),
                    before_filters=[mark_filter],
                )
                if unhook is not None:
                    found += 1
            if found:
                self.log("hook bitmap: installed %d setImageBitmap overload(s)" % found)
        except Exception as error:
            self.log(
                "hook bitmap: FAILED %s: %s"
                % (type(error).__name__, error)
            )

    def _install_dialog_hook(self, dialog_cell):
        try:
            from java.lang import Boolean, Integer

            method = dialog_cell.getDeclaredMethod(
                "update", Integer.TYPE, Boolean.TYPE
            )
            method.setAccessible(True)
            unhook = self._hook(
                label="dialog",
                method=method,
                handler=_DialogFallbackHook(self),
            )
            if unhook is not None:
                self.log("hook dialog: installed DialogCell.update fallback")
        except Exception as error:
            self.log(
                "hook dialog: FAILED %s: %s"
                % (type(error).__name__, error)
            )

    def _find_radius_method(self, image_receiver):
        try:
            methods = image_receiver.getDeclaredMethods()
            for index in range(len(methods)):
                method = methods[index]
                if str(method.getName()) != "setRoundRadius":
                    continue
                params = method.getParameterTypes()
                if len(params) != 1 or not params[0].isArray():
                    continue
                if str(params[0].getComponentType().getName()) == "int":
                    method.setAccessible(True)
                    return method
        except Exception as error:
            self._report_hook_error("find-radius", error)
        return None

    def _hook(self, label, method, handler, before_filters=None, after_filters=None):
        try:
            unhook = self.hook_method(
                method,
                handler,
                priority=50,
                before_filters=before_filters,
                after_filters=after_filters,
            )
            if unhook is None:
                self.log("hook %s: FAILED (registrar returned nothing)" % label)
                return None
            self._add_unhook(unhook)
            self._hooks_ok[label] = True
            return unhook
        except Exception as error:
            self.log(
                "hook %s: FAILED %s: %s"
                % (label, type(error).__name__, error)
            )
            return None

    def _add_unhook(self, unhook):
        if isinstance(unhook, (list, tuple)):
            self._unhooks.extend(unhook)
        else:
            self._unhooks.append(unhook)

    def _remove_hooks(self):
        for unhook in list(self._unhooks or []):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks = []

    def _flag(self, name):
        return "OK" if getattr(self, "_hooks_ok", {}).get(name) else "FAILED"

    # ---- avatar classification / state ------------------------------------

    def _on_avatar_bind(self, receiver, entity):
        if receiver is None:
            return
        with self._lock:
            self._stats["binds"] += 1
            bot = _entity_is_bot(entity)
            if bot:
                self._stats["bots"] += 1
                self._once(
                    "bind",
                    "diag first bind: entity=%s id=%s bot=true parent=%s"
                    % (self._class_name(entity), self._entity_id(entity),
                       self._parent_name(receiver)),
                )
                self._once(
                    "first-bot",
                    "diag first bot detected: id=%s parent=%s"
                    % (self._entity_id(entity), self._parent_name(receiver)),
                )
                self._apply_bot(receiver, "bind")
            else:
                self._stats["nonbots"] += 1
                self._once(
                    "bind",
                    "diag first bind: entity=%s id=%s bot=false parent=%s"
                    % (self._class_name(entity), self._entity_id(entity),
                       self._parent_name(receiver)),
                )
                self._clear_bot(receiver, "bind")
            if self._stats["binds"] % SUMMARY_EVERY == 0:
                self._summary("periodic")

    def _on_image_set(self, receiver, parent_object):
        with self._lock:
            if _entity_is_bot(parent_object):
                parent = self._parent_name(receiver)
                if _is_direct_avatar_parent(parent):
                    self._once(
                        "direct",
                        "diag direct avatar path: bot id=%s parent=%s"
                        % (self._entity_id(parent_object), parent),
                    )
                    self._apply_bot(receiver, "direct")
                else:
                    self._note_unknown_parent(parent, parent_object)
                return
            self._clear_bot(receiver, "image")

    def _on_custom_image(self, receiver):
        with self._lock:
            if receiver is None:
                return
            if not self._is_marked(receiver) and self._baseline_array(receiver) is None:
                return
            self._stats["custom"] += 1
            self._once(
                "custom",
                "diag first custom image on marked receiver: parent=%s"
                % self._parent_name(receiver),
            )
            self._clear_bot(receiver, "custom")

    def _apply_bot(self, receiver, source):
        with self._lock:
            if receiver is None:
                return
            current = self._corners_of(receiver)
            baseline_array = self._baseline_array(receiver)
            if baseline_array is None:
                baseline_array = self._copy_corners(receiver.getRoundRadius())
                if baseline_array is not None:
                    self._baselines.put(receiver, baseline_array)
            baseline = self._array_values(baseline_array)
            size_hint = self._max_corner(baseline)
            if size_hint <= 0:
                size_hint = self._max_corner(current)
            applied = self._bot_radius(receiver, size_hint)
            self._applied.put(receiver, int(applied))
            self._save_mark(receiver)
            if not self._set_mark(receiver, MARKER):
                self._once(
                    "mark-set-failed",
                    "diag could not set ImageReceiver.mark; radius may be overwritten",
                )
            self._enter_apply()
            try:
                try:
                    receiver.setAvatarCornersApplied(True)
                except Exception:
                    pass
                receiver.setRoundRadius(applied)
                try:
                    receiver.invalidate()
                except Exception:
                    pass
                actual = self._corners_of(receiver)
                if self._corners_are(actual, applied):
                    self._stats["verified"] += 1
                    self._once(
                        "verified-bind",
                        "diag radius verified in receiver after %s: %spx (max %ddp)"
                        % (source, applied, BOT_CORNER_RADIUS_DP),
                    )
            finally:
                self._exit_apply()

    def _override_radius(self, receiver, values):
        with self._lock:
            baseline_array = self._baseline_array(receiver)
            if baseline_array is None and not self._is_marked(receiver):
                return
            requested_array = self._copy_corners(values)
            if requested_array is not None:
                self._baselines.put(receiver, requested_array)
            requested = self._array_values(requested_array)
            applied = self._bot_radius(receiver, self._max_corner(requested))
            self._applied.put(receiver, int(applied))
            self._enter_apply()
            try:
                try:
                    receiver.setAvatarCornersApplied(True)
                except Exception:
                    pass
                for index in range(min(4, len(values))):
                    values[index] = applied
                self._stats["overrides"] += 1
                self._once(
                    "override",
                    "diag first radius override: requested=%s parent=%s -> %spx"
                    % (requested, self._parent_name(receiver), applied),
                )
            finally:
                self._exit_apply()

    def _verify_radius(self, receiver):
        with self._lock:
            if receiver is None or not self._is_marked(receiver):
                return
            expected = self._applied_radius(receiver)
            actual = self._corners_of(receiver)
            if self._corners_are(actual, expected):
                self._stats["verified"] += 1
                self._once(
                    "verified-hook",
                    "diag radius verified in receiver after hook: %spx" % expected,
                )
            else:
                self._once(
                    "not-stuck",
                    "diag radius override did not stick: actual=%s expected=%s parent=%s"
                    % (actual, expected, self._parent_name(receiver)),
                )

    def _force_and_verify(self, receiver, source):
        with self._lock:
            applied = self._applied_radius(receiver)
            self._enter_apply()
            try:
                try:
                    receiver.setAvatarCornersApplied(True)
                except Exception:
                    pass
                receiver.setRoundRadius(applied)
                self._stats["dialog"] += 1
                actual = self._corners_of(receiver)
                if self._corners_are(actual, applied):
                    self._stats["verified"] += 1
                    self._once(
                        "verified-dialog",
                        "diag radius verified after %s fallback: %spx" % (source, applied),
                    )
                else:
                    self._once(
                        "dialog-not-stuck",
                        "diag dialog fallback did not stick: actual=%s expected=%s"
                        % (actual, applied),
                    )
            finally:
                self._exit_apply()

    def _clear_bot(self, receiver, source):
        with self._lock:
            if receiver is None:
                return
            marked = self._is_marked(receiver)
            baseline_array = self._baseline_array(receiver)
            if not marked and baseline_array is None:
                return
            current = self._corners_of(receiver)
            applied = self._applied_radius(receiver)
            restore = baseline_array is not None
            if current is not None and not self._corners_are(current, applied):
                # The app already applied a new radius; it is authoritative.
                restore = False
            self._enter_apply()
            try:
                if restore:
                    try:
                        receiver.setAvatarCornersApplied(True)
                    except Exception:
                        pass
                    receiver.setRoundRadius(baseline_array)
                    try:
                        receiver.invalidate()
                    except Exception:
                        pass
            finally:
                self._exit_apply()
            self._restore_mark(receiver)
            try:
                self._baselines.remove(receiver)
            except Exception:
                pass
            try:
                self._applied.remove(receiver)
            except Exception:
                pass
            self._stats["clears"] += 1
            self._once(
                "clear",
                "diag first bot state cleared: source=%s parent=%s restored=%s"
                % (source, self._parent_name(receiver), restore),
            )

    def _restore_all(self):
        baselines = self._baselines
        applied = self._applied
        marks = self._marks
        mark_nulls = self._mark_nulls
        self._baselines = None
        if baselines is None and marks is None and mark_nulls is None:
            return

        def restore():
            with self._lock:
                keys = []
                for mapping in (baselines, marks, mark_nulls):
                    if mapping is None:
                        continue
                    try:
                        keys.extend(list(mapping.keySet()))
                    except Exception:
                        pass
                for receiver in keys:
                    try:
                        baseline_array = baselines.get(receiver) if baselines is not None else None
                        self._enter_apply()
                        try:
                            if baseline_array is not None:
                                try:
                                    receiver.setAvatarCornersApplied(True)
                                except Exception:
                                    pass
                                receiver.setRoundRadius(baseline_array)
                                try:
                                    receiver.invalidate()
                                except Exception:
                                    pass
                        finally:
                            self._exit_apply()
                        self._restore_mark(receiver, marks, mark_nulls)
                    except Exception:
                        pass
                for mapping in (baselines, marks, mark_nulls):
                    if mapping is not None:
                        try:
                            mapping.clear()
                        except Exception:
                            pass
                try:
                    if applied is not None:
                        applied.clear()
                except Exception:
                    pass
                self._summary("unload")

        try:
            from android_utils import run_on_ui_thread

            run_on_ui_thread(restore)
        except Exception:
            pass

    # ---- diagnostic helpers ------------------------------------------------

    def _has_hooks_permission(self):
        try:
            from app.exteraless.plugins import PythonBridge

            allowed = bool(PythonBridge.hasPermission(self.id, "hooks"))
            self.log("diag hooks permission=%s" % allowed)
            if not allowed:
                self.log(
                    "Botile inactive: the 'hooks' permission is not granted. "
                    "Grant it on the plugin permissions screen, then enable Botile again."
                )
            return allowed
        except Exception as error:
            self.log(
                "diag hooks permission query failed (%s: %s); trying anyway"
                % (type(error).__name__, error)
            )
            return True

    def _log_runtime_state(self, after_hooks=False):
        try:
            from app.exteraless.plugins import PythonBridge

            self.log("diag sdk=%s" % PythonBridge.getSdkVersion())
        except Exception as error:
            self.log("diag sdk query failed: %s" % error)
        try:
            xposed = find_class("app.exteraless.plugins.xposed.XposedHooks")
            if xposed is not None:
                self.log(
                    "diag native_hooks ready=%s broken=%s"
                    % (xposed.isReady(), xposed.isNativeHooksBroken())
                )
        except Exception as error:
            self.log("diag native hooks query failed: %s" % error)
        if after_hooks:
            self.log(
                "diag hooks_ok bind=%s radius=%s image=%s bitmap=%s dialog=%s"
                % (
                    self._flag("bind"),
                    self._flag("radius"),
                    self._flag("image"),
                    self._flag("bitmap"),
                    self._flag("dialog"),
                )
            )

    def _summary(self, where):
        self.log(
            "diag %s: binds=%d bots=%d nonbots=%d overrides=%d verified=%d "
            "clears=%d custom=%d dialog=%d unknown_parent=%d"
            % (
                where,
                self._stats.get("binds", 0),
                self._stats.get("bots", 0),
                self._stats.get("nonbots", 0),
                self._stats.get("overrides", 0),
                self._stats.get("verified", 0),
                self._stats.get("clears", 0),
                self._stats.get("custom", 0),
                self._stats.get("dialog", 0),
                self._stats.get("unknown_parent", 0),
            )
        )

    def _once(self, key, message):
        if key in self._firsts:
            return
        if len(self._firsts) >= 12:
            return
        self._firsts.add(key)
        self.log(message)

    def _note_unknown_parent(self, parent, entity):
        self._stats["unknown_parent"] += 1
        key = "unknown:" + str(parent)
        if key in self._firsts:
            return
        if len(self._firsts) >= 12:
            return
        self._firsts.add(key)
        self.log(
            "diag direct avatar parent not covered: %s (bot id=%s); "
            "report this class name for a targeted hook"
            % (parent, self._entity_id(entity))
        )

    def _report_hook_error(self, where, error):
        key = "%s:%s:%s" % (where, type(error).__name__, str(error)[:100])
        if key in self._errors:
            return
        if len(self._errors) >= 6:
            return
        self._errors.add(key)
        self.log(
            "diag hook error [%s]: %s: %s"
            % (where, type(error).__name__, error)
        )

    def _enter_apply(self):
        local = self._local
        local.applying = getattr(local, "applying", 0) + 1

    def _exit_apply(self):
        local = self._local
        local.applying = max(0, getattr(local, "applying", 1) - 1)

    # ---- receiver state helpers -------------------------------------------

    def _bot_radius(self, receiver, size_hint=None):
        """11 dp maximum, scaled down so tiny avatars do not become circles."""
        try:
            width = receiver.getImageWidth()
        except Exception:
            width = 0
        size_px = int(width) if width and width > 0 else 0
        if size_px <= 0 and size_hint is not None and size_hint > 0:
            size_px = int(size_hint) * 2
        if size_px <= 0:
            return self._radius_px
        radius = int(round(size_px * 0.22))
        return max(1, min(self._radius_px, radius))

    def _applied_radius(self, receiver):
        try:
            value = self._applied.get(receiver)
            if value is not None:
                return int(value)
        except Exception:
            pass
        return self._bot_radius(receiver)

    def _baseline_array(self, receiver):
        try:
            return self._baselines.get(receiver)
        except Exception:
            return None

    def _copy_corners(self, values):
        """Copy a four-corner radius, preserving zeros and asymmetry."""
        if values is None:
            return None
        try:
            return self._arrays.copyOf(values, 4)
        except Exception:
            try:
                result = [0, 0, 0, 0]
                for index in range(min(4, len(values))):
                    result[index] = int(values[index])
                return result
            except Exception as error:
                self._report_hook_error("copy-corners", error)
                return None

    def _array_values(self, values):
        if values is None:
            return None
        try:
            result = [0, 0, 0, 0]
            for index in range(min(4, len(values))):
                result[index] = int(values[index])
            return tuple(result)
        except Exception:
            return None

    def _corners_of(self, receiver):
        try:
            return self._array_values(receiver.getRoundRadius())
        except Exception:
            return None

    def _max_corner(self, values):
        if not values:
            return 0
        return max(0, max(values))

    def _corners_are(self, values, applied):
        return values is not None and all(int(value) == applied for value in values)

    def _is_marked(self, receiver):
        try:
            mark = receiver.getMark()
            return mark is not None and str(mark) == MARKER
        except Exception:
            return False

    def _set_mark(self, receiver, value):
        try:
            receiver.setMark(value)
            return True
        except Exception:
            return False

    def _save_mark(self, receiver):
        """Remember the pre-Botile marker, including an explicit null."""
        try:
            current = receiver.getMark()
            if current is not None and str(current) == MARKER:
                return
            try:
                self._marks.remove(receiver)
            except Exception:
                pass
            try:
                self._mark_nulls.remove(receiver)
            except Exception:
                pass
            if current is None:
                self._mark_nulls.put(receiver, True)
            else:
                self._marks.put(receiver, current)
        except Exception as error:
            self._report_hook_error("mark-save", error)

    def _restore_mark(self, receiver, marks=None, mark_nulls=None):
        """Restore the saved marker only while Botile's marker is still there."""
        if marks is None:
            marks = self._marks
        if mark_nulls is None:
            mark_nulls = self._mark_nulls
        try:
            current = receiver.getMark()
            current_is_botile = current is not None and str(current) == MARKER
            saved = False
            original = None
            try:
                if marks is not None and marks.containsKey(receiver):
                    original = marks.get(receiver)
                    saved = True
                elif mark_nulls is not None and mark_nulls.containsKey(receiver):
                    saved = True
            except Exception:
                pass
            if current_is_botile:
                self._set_mark(receiver, original if saved else None)
            # A later external mark (or an explicitly cleared mark) is left alone.
        finally:
            for mapping in (marks, mark_nulls):
                try:
                    mapping.remove(receiver)
                except Exception:
                    pass

    def _parent_name(self, receiver):
        try:
            parent = receiver.getParentView()
            if parent is None:
                return "none"
            return str(parent.getClass().getName())
        except Exception:
            return "?"

    def _class_name(self, entity):
        if entity is None:
            return "null"
        try:
            return str(entity.getClass().getName())
        except Exception:
            return type(entity).__name__

    def _entity_id(self, entity):
        if entity is None:
            return "?"
        try:
            return str(entity.id)
        except Exception:
            return "?"
